# Copy to .env and fill in values. Do not commit .env.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use /status (a single ID is also valid)
ADMIN_IDS=

# Seconds between Playwright checks (default 600, min 15, max 3600)
CHECK_INTERVAL_SECONDS=600

# Electronic-queue page to monitor; change this (and CITY_NAME) for another city
TARGET_URL=https://warszawa.pasport.org.ua/solutions/e-queue
CITY_NAME=Warsaw

# Optional HTTP(S) or SOCKS proxy for Playwright, e.g. http://127.0.0.1:8080
PROXY_URL=

# Set false to show the browser window (needed to pass some Cloudflare JS challenges)
HEADLESS=true

# Playwright storage_state JSON (cookies/localStorage) from scripts/solve_session.py
STORAGE_STATE_PATH=data/storage_state.json

# SQLite file path. Docker Compose overrides this to /app/data/monitor.db
DATABASE_PATH=data/monitor.db

# Optional label of a service dropdown option to click after the page loads
SERVICE_OPTION=

# Playwright navigation timeout in milliseconds
PLAYWRIGHT_TIMEOUT_MS=60000
