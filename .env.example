# Copy to .env and fill in values. Do not commit .env.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Comma-separated admin private-chat IDs for /check_now and diagnostics
ADMIN_IDS=8015085175

# Seconds between Playwright checks (default 300, min 15, max 3600)
CHECK_INTERVAL_SECONDS=300

# Electronic-queue page to monitor; change this (and CITY_NAME) for another city
TARGET_URL=https://warszawa.pasport.org.ua/solutions/e-queue
CITY_NAME=Warsaw

# Required operationally: dedicated Chrome from scripts/start_chrome_cdp.bat
# The bot never launches a browser or creates a tab.
CDP_URL=http://127.0.0.1:9222

# One check cycle then exit (local verification)
CHECK_ONCE=false

# SQLite file path
DATABASE_PATH=data/monitor.db
